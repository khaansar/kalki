# Copy to .env for local runs. Never commit .env.

# --- Secrets ---
# Must match KALKI_SERVICE_SECRET in the baahubali .env.
KALKI_SERVICE_SECRET=CHANGE_ME_UNIQUE_KALKI_SECRET
# Must match API_GATEWAY_SECRET in the baahubali .env.
API_GATEWAY_SECRET=CHANGE_ME_UNIQUE_GATEWAY_SECRET
KALKI_MYSQL_PASSWORD=CHANGE_ME_USE_A_STRONG_DATABASE_PASSWORD
# Needed by kalki-worker only.
OPENAI_API_KEY=CHANGE_ME_OPENAI_API_KEY

# --- Services ---
TEST_SERVICE_URL=http://test-service:8080
ATTEMPT_SERVICE_URL=http://attempt-service:8080
PAYMENT_SERVICE_URL=http://payment-service:8080
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Database (TiDB, same cluster as baahubali) ---
MYSQL_HOST=localhost
MYSQL_PORT=4000
KALKI_MYSQL_DATABASE=kalki
KALKI_MYSQL_USER=kalki
# Set false only for a local database without TLS.
KALKI_MYSQL_TLS_ENABLED=true
# CA bundle path. Empty uses the certifi bundle.
KALKI_MYSQL_TLS_CA_PATH=

# --- Rollout ---
# Master off switch for GET /next.
KALKI_ENABLED=false
# Comma-separated user IDs for a small-group launch. Empty means everyone.
KALKI_ALLOWED_USER_IDS=

# --- Companion behaviour ---
# Wait after any answer, or after a prompt expires.
KALKI_COOLDOWN_MINUTES=30
# Extra wait added per consecutive skip.
KALKI_SKIP_EXTRA_WAIT_MINUTES=30
# Upper limit for the wait after skips.
KALKI_MAX_WAIT_MINUTES=720
# How long a shown prompt can still be answered.
KALKI_PROMPT_TTL_MINUTES=10
# Sleep durations offered to the student.
KALKI_SLEEP_OPTIONS_MINUTES=30,60,240,1440
# A question is not repeated to a student within this window.
KALKI_SEEN_WINDOW_DAYS=30

# --- AI ---
KALKI_OPENAI_MODEL=gpt-4o-mini
KALKI_OPENAI_TIMEOUT_SECONDS=60
# Keep these in step with the chosen model's pricing.
KALKI_OPENAI_INPUT_USD_PER_MILLION=0.15
KALKI_OPENAI_OUTPUT_USD_PER_MILLION=0.60
# The worker stops at this UTC-day limit and resumes the next day.
KALKI_DAILY_SPEND_LIMIT_USD=2.0

# --- Worker ---
# Extra rewrite tries for a question that fails verification.
KALKI_REWRITE_MAX_RETRIES=1
KALKI_JOB_MAX_ATTEMPTS=3
KALKI_JOB_RETRY_DELAY_MINUTES=15
KALKI_WORKER_POLL_SECONDS=10
KALKI_FREE_TESTS_RUN_HOUR_UTC=2
KALKI_KAFKA_TOPIC=attempt-submitted-events
KALKI_KAFKA_GROUP_ID=kalki-worker

# --- Timeouts ---
# Internal calls made while a student waits.
KALKI_LIVE_REQUEST_TIMEOUT_SECONDS=2
KALKI_BLUEPRINT_TIMEOUT_SECONDS=30
